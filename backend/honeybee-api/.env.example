# Copy to .env and enter your actual local PostgreSQL credentials. No quotes needed.
DATABASE_URL=jdbc:postgresql://localhost:5432/honeybee
DATABASE_USERNAME=honeybee
DATABASE_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
PORT=8080
# Leave blank until you configure your own Cloudinary account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Admin credentials are prompted by scripts/Initialize-Admin.ps1, not stored here.
BOOTSTRAP_ADMIN=false
