{
  "info": {
    "name": "Honeybee Frame Shop API",
    "description": "Configure baseUrl and admin credentials locally. Cookies are stored by Postman. Unsafe requests fetch a fresh CSRF token automatically. Multipart JSON parts must use application/json. Example responses are illustrative and not production data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "adminUsername",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "frameId",
      "value": ""
    },
    {
      "key": "imageId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "categorySlug",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (['POST','PUT','DELETE'].includes(pm.request.method)) {",
          "  pm.sendRequest({url:pm.variables.get('baseUrl')+'/auth/csrf',method:'GET'}, function(error,response) {",
          "    if(error || response.code !== 200) throw new Error('Could not fetch CSRF token');",
          "    const csrf=response.json();",
          "    pm.request.headers.upsert({key:csrf.headerName,value:csrf.token});",
          "  });",
          "}"
        ]
      }
    }
  ],
